# Copiá este archivo como .env.local y completá las claves.
# Sin ANTHROPIC_API_KEY la app arma perfiles y pedidos en "modo básico" (reglas, sin IA).
ANTHROPIC_API_KEY=
# Voz (ElevenLabs): dictado y lectura en voz alta. Sin esta clave, la app usa solo el dictado del navegador.
ELEVENLABS_API_KEY=
# Avisos web push (VAPID). Generá un par P-256: la pública va también en vars de wrangler.jsonc.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secreto del panel interno (/admin).
ADMIN_SECRET=
# Cosmos Pay: clave (dv_ = testnet, prod_ = red principal), billetera Stellar que cobra la comisión (tiene que aceptar USDC)
# y secreto del webhook (se obtiene al registrarlo en Cosmos).
COSMOS_API_KEY=
COSMOS_WALLET_COMISION=
COSMOS_WEBHOOK_SECRET=
# Mercado Pago marketplace (opcional).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
